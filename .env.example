# =============================================================================
# CI Agro Helper - Root Environment Configuration
# =============================================================================
# This file contains environment variables for the Docker Compose stack.
# For MVP deployment on a separate App server:
#   1. Copy this file to .env: cp .env.example .env
#   2. Generate secure secrets for JWT_SECRET and SECRET_KEY (see below)
#   3. Update POSTGRES_PASSWORD with a strong password
#   4. Run: docker compose up -d postgres kafka auth recommendations
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL with PostGIS for geospatial data
# For MVP: Use strong password, keep DATABASE_HOST=postgres (Docker network name)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${POSTGRES_DB}

# Recommendations service uses the same database (different schema in future)
RECOMMENDATIONS_DATABASE_URL=${DATABASE_URL}

# =============================================================================
# Authentication Service - JWT Configuration
# =============================================================================
# CRITICAL: Generate secure secrets before MVP deployment!
# Generate with: openssl rand -hex 32
#
# JWT_SECRET: Used to sign JWT access and refresh tokens
# SECRET_KEY: Alternative name for compatibility (should match JWT_SECRET)
#
# For MVP deployment, replace with actual secrets (NOT "change-me-in-production"):
#   JWT_SECRET=<output-from-openssl-rand-hex-32>
#   SECRET_KEY=<same-value-as-JWT_SECRET>
JWT_SECRET=change-me-in-production
SECRET_KEY=change-me-in-production

# Token expiration times (in seconds)
ACCESS_TOKEN_EXPIRES=3600        # 1 hour
REFRESH_TOKEN_EXPIRES=2592000    # 30 days

# =============================================================================
# Upstream Service Configuration (Inter-Service Communication)
# =============================================================================
# These URLs are used for communication between microservices within Docker network.
# IMPORTANT: These use Docker Compose service names as hostnames (auth, recommendations, etc.)
#            DO NOT change these unless modifying docker-compose.yml service names.
#
# Used by: recommendations service to validate JWT tokens with auth service
AUTH_SERVICE_BASE_URL=http://auth:8000
AUTH_SERVICE_TIMEOUT=2.5

# Future field selector service (not yet implemented for MVP)
FIELD_SELECTOR_BASE_URL=http://field-selector:8085
FIELD_SELECTOR_TIMEOUT=3.0

# =============================================================================
# Kafka Event Bus Configuration
# =============================================================================
# For MVP: Keep KAFKA_ENABLED=false (HTTP mode is sufficient)
# Kafka is included in docker-compose.yml for future async event processing
# When ready to enable: Set KAFKA_ENABLED=true and ensure Kafka container is running
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_REQUEST_TOPIC=recommendations.request
KAFKA_RESULT_TOPIC=recommendations.result
KAFKA_CLIENT_ID=recommendations-service
KAFKA_GROUP_ID=recommendations-worker
KAFKA_POLL_TIMEOUT_MS=1000
KAFKA_RETRY_BACKOFF_SECONDS=1.0
KAFKA_MAX_RETRY_ATTEMPTS=5

# =============================================================================
# Frontend BFF (Backend-for-Frontend) Configuration
# =============================================================================
# These URLs configure how the Next.js frontend communicates with backend services.
# IMPORTANT: Use Docker service names (auth, recommendations) for internal communication.
#            These are NOT exposed externally - only frontend port 3000 is public.
#
# For production deployment with Nginx Proxy Manager:
#   - External users access https://app.example.com (NPM proxies to frontend:3000)
#   - Frontend BFF layer proxies API requests to internal services
#   - Direct access to auth:8000 and recommendations:8000 should be blocked externally
AUTH_SERVICE_URL=http://auth:8000
RECOMMENDATIONS_SERVICE_URL=http://recommendations:8000

# Optional: External API keys for frontend features (keep in .env, never commit)
# PLANET_API_KEY=<your-planet-labs-api-key>
# WEATHER_API_KEY=<your-weatherapi-key>

# =============================================================================
# Observability & Monitoring
# =============================================================================
# Prometheus metrics exposed at /metrics endpoint
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_METRICS_PATH=/metrics

# OpenTelemetry (optional, leave empty for MVP)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_SERVICE_NAME=recommendations-service
